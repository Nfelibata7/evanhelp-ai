# Chat、Embedding、Rerank 可以使用同一家服务，也可分别配置。
# 以下为 OpenAI 兼容服务示例；请填入真实模型名与本机密钥。
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_API_KEY=replace-me

# 若更换 Embedding 或 Rerank 服务，请同时修改对应的 BASE_URL 和 model 设置。
EMBED_API_KEY=replace-me
RERANK_API_KEY=replace-me

# 可选参数
TOKEN_BUDGET=2000
CHAT_THINKING=disabled
# CHAT_REASONING_EFFORT=low
# CHAT_REASONING_SPLIT=true

# 数据库默认值适用于本地 Docker Compose。
# DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/evanhelp
# TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/evanhelp_test

# 本地 MCP 服务地址
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
DEMO_TICKET_DELAY_SECONDS=0

# 可选 Langfuse 追踪
# LANGFUSE_PUBLIC_KEY=replace-me
# LANGFUSE_SECRET_KEY=replace-me
# LANGFUSE_BASE_URL=http://localhost:3000